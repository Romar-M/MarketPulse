# MarketPulse Configuration
# Copy to .env and fill in values

# Threshold for alerts (e.g. 0.01 = 1%)
THRESHOLD=0.01

# Telegram bot (optional - leave empty to disable)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Encryption key (optional - auto-generated if empty)
ENCRYPTION_KEY=

# JWT secret key (change in production!)
JWT_SECRET_KEY=super-secret-key-change-me
